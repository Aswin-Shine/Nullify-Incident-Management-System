        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome) (rate(nullify_signals_processed_total[2m]))",
          "legendFormat": "processed {{outcome}}"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(nullify_signals_rejected_total[2m]))",
          "legendFormat": "rejected (429)"
