      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(nullify_ingest_queue_depth)",
          "legendFormat": "depth"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(nullify_ingest_queue_capacity)",
          "legendFormat": "capacity"
