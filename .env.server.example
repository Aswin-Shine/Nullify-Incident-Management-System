# Nullify on the EC2 server: copy to /opt/nullify/.env next to docker-compose.yml and fill in (never commit it).
# Everything here is read by docker compose (infra/README.md). Local development uses .env.example instead.

# ── Secrets: a fresh `openssl rand -hex 32` for each ─────────────────────
APP_SECRET_KEY=
DB_PASSWORD=
REDIS_PASSWORD=

# ── HTTPS: Caddy gets a Let's Encrypt certificate, redirects HTTP and sends HSTS ──
COMPOSE_PROFILES=tls,monitoring
DOMAIN=nullify-ims.duckdns.org 
ACME_EMAIL=ash.91@gmail.com
# Caddy owns ports 80 and 443, so nginx listens on loopback only.
FRONTEND_PORT=127.0.0.1:3000
# The browser's origin: https and the domain, no port.
ALLOWED_ORIGINS=["https://nullify-ims.duckdns.org"]

# ── Set by deploys (infra/deploy.sh): the commit SHA whose images run here. Absent means `v1`. ──
# IMAGE_TAG=

# ── Optional integrations (blank = disabled) ─────────────────────────────
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
OTLP_ENDPOINT=

# ── Monitoring: set COMPOSE_PROFILES=tls,monitoring (deploy.sh fetches monitoring/) ──
# Grafana refuses to start without a password. Reach it with: ssh -L 3001:127.0.0.1:3001 ubuntu@<ip>
GRAFANA_ADMIN_PASSWORD=
