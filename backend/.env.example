# ── App ───────────────────────────────────────────────────────────────────
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=CHANGE_ME_generate_a_32_plus_char_random_string
DEBUG=false

# ── PostgreSQL ────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=ims

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── JWT ───────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Webhooks (optional) ───────────────────────────────────────────────────
# Leave blank to disable
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=

# ── OpenTelemetry (optional) ──────────────────────────────────────────────
# Leave blank to disable
OTLP_ENDPOINT=

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
