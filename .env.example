# Nullify: the project's ONE env file. Copy to .env at the repo root and fill in (never commit it).
#
#   Local dev:  the backend reads <repo>/.env from any working directory
#   Docker:     docker compose up -d   (compose reads .env automatically and overrides
#               DB_HOST/REDIS_HOST/APP_ENV for the containers)
#   Server:     keep its own .env with production values next to docker-compose.yml

# ── App ───────────────────────────────────────────────────────────────────
APP_ENV=development
# 32+ random characters; the app refuses to start in production with less:
#   openssl rand -hex 32
APP_SECRET_KEY=
DEBUG=false
LOG_LEVEL=INFO

# ── PostgreSQL ────────────────────────────────────────────────────────────
# Docker's Postgres is created with DB_USER / DB_PASSWORD / DB_NAME and needs a password.
DB_HOST=localhost
DB_PORT=5432
DB_USER=nullify
DB_PASSWORD=
DB_NAME=nullify

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Auth / browser ────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Every origin the UI is served from, port included (Vite dev :5173, Docker :FRONTEND_PORT)
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost","http://127.0.0.1"]
# Refresh cookie is HTTPS-only. localhost counts as secure; set false only for plain-HTTP servers.
COOKIE_SECURE=true

# ── Docker Compose only ───────────────────────────────────────────────────
FRONTEND_PORT=80

# ── Optional integrations (blank = disabled) ──────────────────────────────
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
OTLP_ENDPOINT=
